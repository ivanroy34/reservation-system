# ==============================================================================
# Django Core Settings
# ==============================================================================
# A secret, unique key for this Django installation. Keep this safe in production!
# Generate a new key using: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your_django_secret_key_here

# Set to True for local development, False for production deployment
DEBUG=True

# Comma-separated list of host/domain names that this Django site can serve
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]


# ==============================================================================
# Database Configuration (MySQL)
# ==============================================================================
# Database engine plugin to use (e.g., django.db.backends.mysql or django.db.backends.postgresql)
DB_ENGINE=django.db.backends.mysql

# Name of the target database
DB_NAME=reservation_db

# Database user account
DB_USER=root

# Password for the database user account (leave empty if no password, e.g., local Laragon default)
DB_PASSWORD=your_db_password_here

# Database host address (use 127.0.0.1 or localhost for local server, or hostname for Docker/remote DB)
DB_HOST=127.0.0.1

# Network port for database service (default: 3306 for MySQL, 5432 for PostgreSQL)
DB_PORT=3306


# ==============================================================================
# Email Configuration
# ==============================================================================
# Email backend class to use for sending emails.
# Use 'django.core.mail.backends.console.EmailBackend' for local testing (prints to terminal).
# Use 'django.core.mail.backends.smtp.EmailBackend' for production SMTP delivery.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP server hostname (e.g., smtp.gmail.com or smtp.sendgrid.net)
EMAIL_HOST=smtp.gmail.com

# SMTP server port (usually 587 for TLS or 465 for SSL)
EMAIL_PORT=587

# Set to True to use explicit TLS encryption (recommended for port 587)
EMAIL_USE_TLS=True

# Username/email address for authenticating with the SMTP server
EMAIL_HOST_USER=your_email@example.com

# Password or App Password for SMTP authentication
EMAIL_HOST_PASSWORD=your_email_app_password_here

# Default address to use for sender in emails sent from the system
DEFAULT_FROM_EMAIL=Roy's Bistro <noreply@roysbistro.com>


# ==============================================================================
# Security & CSRF Settings
# ==============================================================================
# Comma-separated list of trusted origins for unsafe requests (e.g. POST requests over HTTPS)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Set to True in production to force all non-HTTPS connections to be redirected to HTTPS
SECURE_SSL_REDIRECT=False


# ==============================================================================
# Internationalization & Localization
# ==============================================================================
# Language code for this installation
LANGUAGE_CODE=en-us

# Timezone setting for datetime handling (e.g. UTC, Asia/Manila, America/New_York)
TIME_ZONE=UTC
